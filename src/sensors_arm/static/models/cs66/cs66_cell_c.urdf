  <!-- Cell C EE: EFG-C65 gripper directly on flange (no KWR75). CAD: cad/EFG-C65.STEP -->
  <link name="gripper_centor_link">
    <inertial>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
