    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/EFG-C65.v3.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="gripper_centor_fixed" type="fixed">
    <!-- Flange mount (no KWR75); EFG-C65 mesh mount@z0, tip@z≈0.117 -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="link6"/>
    <child link="gripper_centor_link"/>
  </joint>

  <!-- Cell C EOAT: dual fingertips (prismatic open along tool ±X) + D405 bracket/clamp/camera.
       Meshes = closed-ish CAD pose; joint 0=closed, +0.033 m/side ≈ EFG-C65 half-stroke (66 mm total).
       Tool frame: X open, Y lateral, Z toward tip. See scripts/import_efg_c65_d405_eoat.py -->
  <link name="gripper_fingertip_l_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/EFG-C65_D405_fingertip_l.STL"/>
      </geometry>
      <material name="eoat_fingertip">
        <color rgba="0.75 0.78 0.82 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/EFG-C65_D405_fingertip_l.STL"/>
      </geometry>
    </collision>
  </link>
  <!-- Driven opening: 0=closed, 0.033=open (+X). Force 60–300 N (URDF effort=max);
       speed 32.5 mm / 0.7 s (EFG-C65). -->
  <joint name="gripper_opening" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="gripper_centor_link"/>
    <child link="gripper_fingertip_l_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.033" effort="300" velocity="0.04642857143"/>
  </joint>

  <link name="gripper_fingertip_r_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
