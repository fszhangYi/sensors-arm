        <color rgba="0.75 0.78 0.82 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/EFG-C65_D405_fingertip_r.STL"/>
      </geometry>
    </collision>
  </link>
  <!-- Right finger mirrors opening (−X). -->
  <joint name="gripper_finger_r" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="gripper_centor_link"/>
    <child link="gripper_fingertip_r_link"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.033" effort="300" velocity="0.04642857143"/>
    <mimic joint="gripper_opening" multiplier="1" offset="0"/>
  </joint>

